# ============================================================
# 阿墨墨打字通 - AI 配置说明
# 使用方法：把本文件复制一份命名为 .env，填入你的密钥，然后重启 npm run dev
# ============================================================

# --- 智谱 GLM（AI 故事生成，推荐）---
# 注册地址：https://open.bigmodel.cn （注册后在「API密钥」页面创建）
# 免费额度：GLM-4-Flash 模型完全免费
ZHIPU_API_KEY=

# --- Google Gemini（可选，仅供 AI Studio 部署环境，国内无法直连）---
GEMINI_API_KEY=

# ============================================================
# 语音说明（无需任何配置）：
# - 本地 npm run dev 时自动启用微软 Edge 神经音色（免费无密钥）：
#   粤语·曉曼 / 普通话·晓晓 / 英语·Aria，真人级音质
# - 部署到无 Node 服务的环境（如 AI Studio）时自动回退浏览器语音
# ============================================================
